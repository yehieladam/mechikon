{
  "name": "mechikon",
  "version": "0.1.1",
  "private": true,
  "description": "Fully client-side Hebrew PII anonymizer - Chrome extension (MV3) + reusable framework-free engine",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/vendor-ort.mjs",
    "build": "vite build",
    "dev:web": "vite --config web/vite.config.ts",
    "vendor:ocr": "node scripts/fetch-tesseract-assets.mjs",
    "prebuild:web": "node scripts/fetch-tesseract-assets.mjs || echo \"WARN: tesseract OCR assets not vendored; scanned-PDF OCR stays unavailable until re-vendored (build continues, site unaffected).\"",
    "build:web": "vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier -w .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "preview:e2e": "vite preview --config web/vite.config.ts --port 4173 --strictPort",
    "fixtures:pdf": "node web/test-fixtures/build-pdf-fixtures.mjs",
    "test:e2e": "playwright test --grep-invert @model",
    "pretest:e2e": "npm run fixtures:pdf",
    "pretest": "npm run fixtures:pdf",
    "test:e2e:model": "playwright test --grep @model",
    "test:e2e:ext": "playwright test --config playwright.ext.config.ts",
    "pack": "npm run build && node scripts/pack-extension.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@vercel/analytics": "^2.0.1",
    "comlink": "^4.4.2",
    "i18next": "^23.16.8",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "mupdf": "^1.28.0",
    "react-i18next": "^14.1.3",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@crxjs/vite-plugin": "^2.0.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
